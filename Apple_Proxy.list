# NAME: Apple-Proxy
# AUTHOR: Revised by Codex
# UPDATED: 2026-08-18
# DESCRIPTION: Region-sensitive Apple services that should always use the proxy. Load before Apple_Rule.list.

# Apple Intelligence / Private Cloud Compute
DOMAIN,apple-relay.apple.com,extended-matching
DOMAIN,apple-relay.fastly-edge.com,extended-matching
DOMAIN,apple-relay.cloudflare.com,extended-matching
DOMAIN,cp4.cloudflare.com,extended-matching

# Apple News
DOMAIN,news-assets.apple.com,extended-matching
DOMAIN,news-client.apple.com,extended-matching
DOMAIN,news-edge.apple.com,extended-matching
DOMAIN,news-events.apple.com,extended-matching
DOMAIN-SUFFIX,apple.news,extended-matching
USER-AGENT,AppleNews*
USER-AGENT,com.apple.news*

# Apple TV / region-sensitive media
DOMAIN,hls-svod.itunes.apple.com,extended-matching
DOMAIN,js-cdn.music.apple.com,extended-matching
DOMAIN,np-edge.itunes.apple.com,extended-matching
DOMAIN,play-edge.itunes.apple.com,extended-matching
DOMAIN,tv.applemusic.com,extended-matching
DOMAIN,uts-api.itunes.apple.com,extended-matching
DOMAIN-SUFFIX,audio-ssl.itunes.apple.com,extended-matching
DOMAIN-SUFFIX,hls-amt.itunes.apple.com,extended-matching
DOMAIN-SUFFIX,hls.itunes.apple.com,extended-matching
DOMAIN-SUFFIX,tv.apple.com,extended-matching
USER-AGENT,AppleTV*
USER-AGENT,com.apple.tv*
